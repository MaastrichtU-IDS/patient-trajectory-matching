{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "id",
    "dataset_id",
    "mode",
    "time_policy",
    "patient_ids",
    "itemids"
  ],
  "properties": {
    "profile": {
      "const": "mimic-measurement-import-1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "maxLength": 128
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "mode": {
      "const": "retrospective_source_records"
    },
    "time_policy": {
      "const": "recorded-point-label-exact-v1"
    },
    "patient_ids": {
      "oneOf": [
        {
          "const": "all"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$",
            "maxLength": 128
          }
        }
      ]
    },
    "itemids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$",
        "maxLength": 128
      }
    }
  }
}
