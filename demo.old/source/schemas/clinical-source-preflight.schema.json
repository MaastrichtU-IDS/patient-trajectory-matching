{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "id",
    "dataset_id",
    "treatment_itemids",
    "measurement_itemids"
  ],
  "properties": {
    "profile": {
      "const": "clinical-source-preflight-1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "maxLength": 128
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "treatment_itemids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$",
        "maxLength": 16
      }
    },
    "measurement_itemids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$",
        "maxLength": 16
      }
    }
  }
}
