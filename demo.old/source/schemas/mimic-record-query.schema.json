{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "id",
    "dataset_id",
    "mode",
    "time_policy",
    "patient_ids",
    "slots",
    "constraints"
  ],
  "properties": {
    "profile": {
      "const": "mimic-record-query-1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "mode": {
      "const": "retrospective_source_records"
    },
    "time_policy": {
      "const": "recorded-label-exact-v1"
    },
    "patient_ids": {
      "oneOf": [
        {
          "const": "all"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          }
        }
      ]
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "itemids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "itemids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "left",
          "right",
          "operator"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "left": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "right": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "operator": {
            "enum": [
              "before",
              "meets",
              "overlaps",
              "gap"
            ]
          },
          "min_gap_us": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "max_gap_us": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "operator": {
                  "const": "gap"
                }
              }
            },
            "then": {
              "required": [
                "min_gap_us",
                "max_gap_us"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "min_gap_us"
                    ]
                  },
                  {
                    "required": [
                      "max_gap_us"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    }
  }
}
