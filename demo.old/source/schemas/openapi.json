  "components": {
    "schemas": {
      "Time": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "point",
              "interval"
            ]
          },
          "clock_id": {
            "type": "string",
            "minLength": 1
          },
          "start_min_us": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "start_max_us": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "end_min_us": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "end_max_us": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "precision": {
            "type": "string",
            "enum": [
              "microsecond",
              "second",
              "minute",
              "day",
              "unknown"
            ]
          },
          "timestamp_role": {
            "type": "string",
            "enum": [
              "occurrence",
              "measurement_associated",
              "order",
              "recording",
              "unknown"
            ]
          }
        },
        "required": [
          "kind",
          "clock_id",
          "start_min_us",
          "start_max_us",
          "end_min_us",
          "end_max_us",
          "precision",
          "timestamp_role"
        ],
        "additionalProperties": false
      },
      "Provenance": {
        "type": "object",
        "properties": {
          "source_file": {
            "type": "string",
            "minLength": 1
          },
          "source_key": {
            "type": "string",
            "minLength": 1
          },
          "source_record_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "adapter_rule": {
            "type": "string",
            "minLength": 1
          },
          "assertion_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "source_file",
          "source_key",
          "source_record_sha256",
          "adapter_rule",
          "assertion_ids"
        ],
        "additionalProperties": false
      },
      "Event": {
        "type": "object",
        "properties": {
          "dataset_id": {
            "type": "string",
            "minLength": 1
          },
          "snapshot_id": {
            "type": "string",
            "minLength": 1
          },
          "patient_id": {
            "type": "string",
            "minLength": 1
          },
          "episode_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "clinical_event_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "event_kind": {
            "type": "string",
            "enum": [
              "measurement",
              "administration",
              "prescription",
              "diagnosis",
              "procedure",
              "other"
            ]
          },
          "concept": {
            "type": "string",
            "minLength": 1
          },
          "source_code": {
            "type": "string",
            "minLength": 1
          },
          "source_system": {
            "type": "string",
            "minLength": 1
          },
          "mapping_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "performed",
              "planned",
              "not_given",
              "negated",
              "unknown"
            ]
          },
          "experiencer": {
            "type": "string",
            "enum": [
              "patient",
              "family",
              "other",
              "unknown"
            ]
          },
          "time": {
            "$ref": "#/components/schemas/Time"
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "original_value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "original_unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "comparator": {
            "type": "string",
            "enum": [
              "eq",
              "lt",
              "le",
              "gt",
              "ge",
              "unknown"
            ]
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "record_version": {
            "type": "integer",
            "minimum": 1
          },
          "supersedes": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "dataset_id",
          "snapshot_id",
          "patient_id",
          "episode_id",
          "event_id",
          "record_id",
          "clinical_event_id",
          "event_kind",
          "concept",
          "source_code",
          "source_system",
          "mapping_ref",
          "status",
          "experiencer",
          "time",
          "value",
          "unit",
          "original_value",
          "original_unit",
          "comparator",
          "provenance",
          "record_version",
          "supersedes"
        ],
        "additionalProperties": false
      },
      "Slot": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "measurement",
              "administration",
              "prescription",
              "diagnosis",
              "procedure",
              "other"
            ]
          },
          "concept": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "concept"
        ],
        "additionalProperties": false
      },
      "Constraint": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "op": {
                "const": "before"
              },
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "op",
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "op": {
                "const": "max_gap"
              },
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "seconds": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "op",
              "from",
              "to",
              "seconds"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "op": {
                "const": "value_delta_min"
              },
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "op",
              "from",
              "to",
              "value",
              "unit"
            ],
            "additionalProperties": false
          }
        ]
      },
      "Relaxation": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "op": {
                "const": "concept_alternative"
              },
              "concept": {
                "type": "string",
                "minLength": 1
              },
              "cost": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
                "not": {
                  "pattern": "^0(\\.0+)?$"
                }
              },
              "review": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "target",
              "op",
              "concept",
              "cost",
              "review"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "op": {
                "const": "extend_max_gap"
              },
              "extra_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "maximum_cost": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
                "not": {
