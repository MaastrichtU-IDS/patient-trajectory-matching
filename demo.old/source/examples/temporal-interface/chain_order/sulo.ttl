<https://example.org/trajectory/bounded-data/variables/Cs/source-location> a ex:SourceLocation ;
    sulo:hasValue "constructed://bounded-interval/source.json"^^xsd:string .

<https://example.org/trajectory/bounded-data/variables/Cs/upper> a bt:UpperBound ;
    sulo:hasDirectPart bt:Microsecond ;
    sulo:hasValue 5 .

