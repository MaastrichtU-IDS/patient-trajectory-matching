TemporalDocument(
  Snapshot(reviewExample GFOBoundaryMicrosecond
    OntologyRef(<urn:temporal-trajectory:review-example>)
    AdmissionPolicy(<urn:policy:synthetic-explicit-assertions-v1>)
    Clock(c "2026-09-01T00:00:00Z" Patient(P))
    Variable(a_start Scope(P E c) 0 0 <urn:evidence:a-start>)
    Variable(a_end Scope(P E c) 60000000 60000000 <urn:evidence:a-end>)
    Variable(b_start Scope(P E c) 2880000000 3000000000 <urn:evidence:b-start>)
    Variable(b_end Scope(P E c) 3060000000 3060000000 <urn:evidence:b-end>)
    Variable(middle Scope(P E c) 900000000 900000000 <urn:evidence:middle>)
    Variable(window_end Scope(P E c) 1800000000 1800000000 <urn:evidence:window-end>)
    Interval(aExtent)
    Interval(bExtent)
    Interval(firstStateExtent)
    Interval(secondStateExtent)
    Boundary(aLeft Left aExtent a_start)
    Boundary(aRight Right aExtent a_end)
    Boundary(bLeft Left bExtent b_start)
    Boundary(bRight Right bExtent b_end)
    Boundary(lowLeft Left firstStateExtent a_start)
    Boundary(lowRight Right firstStateExtent middle)
    Boundary(nextLowLeft Left secondStateExtent middle)
    Boundary(lastLowRight Right secondStateExtent window_end)
    Event(a <urn:example:administration> P E aExtent <urn:evidence:administration>)
    Event(b <urn:example:collection> P E bExtent <urn:evidence:collection>)
    StateAssertion(low1 P E c <urn:state:low> Positive firstStateExtent <urn:evidence:low1>)
    StateAssertion(low2 P E c <urn:state:low> Positive secondStateExtent <urn:evidence:low2>)
    Observation(sample1 P E c <urn:state:low> Positive aLeft <urn:evidence:sample1>)
    Observation(sample2 P E c <urn:state:low> Positive lastLowRight <urn:evidence:sample2>)
  )
  TrajectoryQuery(minuteQuery P E
    Slots(
      Slot(a IntervalExtent <urn:example:Administration>)
      Slot(b IntervalExtent <urn:example:Collection>)
    )
    Conditions(Condition(completionGap Gap(a b 0 2880000000)))
  )
  Relaxation(reviewedWindows minuteQuery 2.00 1
    Relaxable(completionGap)
    Option(widen 1.25 Widen(completionGap 0 3000000000))
  )
  CoverageQuery(continuousLow P E c <urn:state:low> 0 1800000000)
)
