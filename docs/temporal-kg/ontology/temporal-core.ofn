EquivalentClasses(:TemporalEntity ObjectUnionOf(:TimePoint :TimeInterval))
DisjointClasses(:TimePoint :TimeInterval)
DisjointClasses(:TemporalEntity :Process :TemporalSituation :AssertionRecord :SourceRecord)
SubClassOf(:TimeInterval ObjectExactCardinality(1 :hasBeginning :TimePoint))
SubClassOf(:TimeInterval ObjectExactCardinality(1 :hasEnd :TimePoint))
ObjectPropertyDomain(:hasBeginning :TimeInterval)
ObjectPropertyRange(:hasBeginning :TimePoint)
ObjectPropertyDomain(:hasEnd :TimeInterval)
ObjectPropertyRange(:hasEnd :TimePoint)
FunctionalObjectProperty(:hasBeginning)
FunctionalObjectProperty(:hasEnd)
DisjointObjectProperties(:hasBeginning :hasEnd)
ObjectPropertyDomain(:exactExtent :Process)
ObjectPropertyRange(:exactExtent :TemporalEntity)
FunctionalObjectProperty(:exactExtent)
EquivalentClasses(:InstantaneousProcess ObjectIntersectionOf(:Process ObjectSomeValuesFrom(:exactExtent :TimePoint)))
EquivalentClasses(:ExtendedProcess ObjectIntersectionOf(:Process ObjectSomeValuesFrom(:exactExtent :TimeInterval)))
SubClassOf(:TemporalSituation ObjectExactCardinality(1 :validExtent :TemporalEntity))
ObjectPropertyDomain(:validExtent :TemporalSituation)
ObjectPropertyRange(:validExtent :TemporalEntity)
FunctionalObjectProperty(:validExtent)
SubClassOf(:BedOccupancySituation :TemporalSituation)
SubClassOf(:BedOccupancySituation ObjectExactCardinality(1 :hasOccupant :Patient))
SubClassOf(:BedOccupancySituation ObjectExactCardinality(1 :occupiedBed :Bed))
ObjectPropertyDomain(:hasOccupant :BedOccupancySituation)
ObjectPropertyRange(:hasOccupant :Patient)
ObjectPropertyDomain(:occupiedBed :BedOccupancySituation)
ObjectPropertyRange(:occupiedBed :Bed)
FunctionalObjectProperty(:hasOccupant)
FunctionalObjectProperty(:occupiedBed)
SubClassOf(:PatientRole :Role)
SubClassOf(:AdministeredDrugRole :Role)
SubClassOf(:DrugAdministration :Process)
SubClassOf(:BloodSpecimenCollection :Process)
ObjectPropertyDomain(:hasParticipant :Process)
ObjectPropertyDomain(:isFeatureOf :Role)
SubObjectPropertyOf(ObjectPropertyChain(:hasParticipant :isFeatureOf) :hasParticipant)
EquivalentClasses(:AntibioticAdministration ObjectIntersectionOf(:DrugAdministration ObjectSomeValuesFrom(:hasParticipant ObjectIntersectionOf(:AdministeredDrugRole ObjectSomeValuesFrom(:isFeatureOf :Antibiotic)))))
ObjectPropertyDomain(:aboutEntity :AssertionRecord)
ObjectPropertyDomain(:supportedBy :AssertionRecord)
ObjectPropertyRange(:supportedBy :SourceRecord)
ObjectPropertyDomain(:supersedes :AssertionRecord)
ObjectPropertyRange(:supersedes :AssertionRecord)
ObjectPropertyDomain(:pointBefore :TimePoint)
ObjectPropertyRange(:pointBefore :TimePoint)
InverseObjectProperties(:pointBefore :pointAfter)
AsymmetricObjectProperty(:pointBefore)
