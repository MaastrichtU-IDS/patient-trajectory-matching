@prefix bt: <https://example.org/trajectory/bounded/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

bt:Profile a owl:Ontology ; rdfs:comment "Bounded discrete microsecond intervals. Source JSON and its compiler define arithmetic semantics. Load with pinned SULO and the PRO/SOLID and exact-interval class modules. No new properties." .
bt:IntervalProcess a owl:Class ; rdfs:subClassOf sulo:Process .
bt:Infusion a owl:Class ; rdfs:subClassOf bt:IntervalProcess .
bt:SpecimenCollection a owl:Class ; rdfs:subClassOf bt:IntervalProcess .

# What a source row asserts, held apart from whether it is so. Same reference-object
# pattern as the PRO/SOLID and exact-interval profiles: each process class IRI is punned
# as a sulo:Collection individual, and a claim says which kind of process it reports by
# referring to that individual. The collection is empty, so no process is entailed.
bt:IntervalClaim a owl:Class ; rdfs:subClassOf sulo:InformationObject .
bt:OccurrenceInterval a owl:Class ; rdfs:subClassOf sulo:TimeInterval .
bt:StartDescriptor a owl:Class ; rdfs:subClassOf sulo:StartTime .
bt:EndDescriptor a owl:Class ; rdfs:subClassOf sulo:EndTime .
bt:TemporalVariable a owl:Class ; rdfs:subClassOf sulo:InformationObject .
bt:LowerBound a owl:Class ; rdfs:subClassOf sulo:InformationObject .
bt:UpperBound a owl:Class ; rdfs:subClassOf sulo:InformationObject .
bt:DifferenceConstraint a owl:Class ; rdfs:subClassOf sulo:InformationObject .
bt:LeftOperandBinding a owl:Class ; rdfs:subClassOf sulo:InformationObject .
bt:RightOperandBinding a owl:Class ; rdfs:subClassOf sulo:InformationObject .
bt:OperatorDatum a owl:Class ; rdfs:subClassOf sulo:InformationObject .
bt:Snapshot a owl:Class ; rdfs:subClassOf sulo:InformationObject .
bt:DatasetIdentifier a owl:Class ; rdfs:subClassOf sulo:InformationObject .
bt:SnapshotIdentifier a owl:Class ; rdfs:subClassOf sulo:InformationObject .
bt:Microsecond a sulo:Unit .

bt:RecordedInputSegment a owl:Class ; rdfs:subClassOf bt:IntervalProcess ;
  rdfs:comment "A process as described by one admitted input-component source row. The disclaimer this comment used to carry -- that the class does not imply a clinically verified infusion -- is now carried by the axioms: a source row produces a bt:IntervalClaim referring to this class as an empty reference collection, so no instance of it is entailed. An instance appears only when a claim is accepted." .

bt:Infusion a owl:NamedIndividual, sulo:Collection ;
  owl:equivalentClass [ a owl:Restriction ; owl:onProperty sulo:isItemIn ; owl:hasValue bt:Infusion ] .
bt:SpecimenCollection a owl:NamedIndividual, sulo:Collection ;
  owl:equivalentClass [ a owl:Restriction ; owl:onProperty sulo:isItemIn ; owl:hasValue bt:SpecimenCollection ] .
bt:RecordedInputSegment a owl:NamedIndividual, sulo:Collection ;
  owl:equivalentClass [ a owl:Restriction ; owl:onProperty sulo:isItemIn ; owl:hasValue bt:RecordedInputSegment ] .
