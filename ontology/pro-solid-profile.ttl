@prefix ex: <https://example.org/trajectory/toy/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:ProSolidProfile a owl:Ontology ;
  rdfs:comment "Application classes for the bounded PRO/SOLID adapter. SULO is resolved locally through sulo-pin.json. No new object or datatype properties." .

ex:Person a owl:Class ; rdfs:subClassOf sulo:SpatialObject .
ex:RecordedClinicalProcess a owl:Class ; rdfs:subClassOf sulo:Process .
ex:Measurement a owl:Class ; rdfs:subClassOf ex:RecordedClinicalProcess .
ex:AdministrationRecordProcess a owl:Class ; rdfs:subClassOf ex:RecordedClinicalProcess .
ex:DrugAdministration a owl:Class ; rdfs:subClassOf ex:AdministrationRecordProcess .
ex:PatientRole a owl:Class ; rdfs:subClassOf sulo:Role .
ex:CareProviderRole a owl:Class ; rdfs:subClassOf sulo:Role .
ex:MeasurementResultRole a owl:Class ; rdfs:subClassOf sulo:Role .
ex:AdministeredDrugRole a owl:Class ; rdfs:subClassOf sulo:Role .
ex:CreatinineResult a owl:Class ; rdfs:subClassOf sulo:Quantity .
ex:CreatinineConcentration a owl:Class ; rdfs:subClassOf sulo:Quality .
ex:DrugA a owl:Class ; rdfs:subClassOf sulo:SpatialObject .
ex:DrugAChild a owl:Class ; rdfs:subClassOf ex:DrugA .
ex:DrugB a owl:Class ; rdfs:subClassOf sulo:SpatialObject .
ex:SourceRecord a owl:Class ; rdfs:subClassOf sulo:InformationObject .
ex:RecordedAnchorTime a owl:Class ; rdfs:subClassOf sulo:TimeInstant .
ex:PatientIdentifier a owl:Class ; rdfs:subClassOf sulo:InformationObject .
ex:EventIdentifier a owl:Class ; rdfs:subClassOf sulo:InformationObject .
ex:RecordIdentifier a owl:Class ; rdfs:subClassOf sulo:InformationObject .
ex:EpisodeIdentifier a owl:Class ; rdfs:subClassOf sulo:InformationObject .
ex:SourceKey a owl:Class ; rdfs:subClassOf sulo:InformationObject .
ex:SourceLocation a owl:Class ; rdfs:subClassOf sulo:InformationObject .
ex:SourceHash a owl:Class ; rdfs:subClassOf sulo:InformationObject .
ex:RecordStatus a owl:Class ; rdfs:subClassOf sulo:InformationObject .
ex:SourceCode a owl:Class ; rdfs:subClassOf sulo:InformationObject .

[] a owl:AllDisjointClasses ; owl:members (ex:PatientRole ex:CareProviderRole ex:MeasurementResultRole ex:AdministeredDrugRole) .
ex:Measurement owl:disjointWith ex:AdministrationRecordProcess .
ex:MilligramPerDecilitre a sulo:Unit .
ex:MilligramPerLitre a sulo:Unit .
ex:Second a sulo:Unit .

# Reference objects for the two kinds of process a record can be about.
#
# Each process class IRI is punned as a sulo:Collection individual. A record says which
# kind of process it reports by referring to that individual, which asserts nothing about
# any process having occurred: the collection is empty until a claim is accepted. The
# equivalence ties membership to instantiation, so an accepted claim that adds a member
# makes it an instance of the class, and nothing else does.
#
# Punning rather than minting a separate reference individual per concept: the class IRI
# already carries an identity policy, and a shadow namespace would need its own. The
# restriction uses sulo:isItemIn with owl:hasValue, both of which are in OWL 2 EL, so an
# EL consumer classifies these the same way. A proxy-class form would need owl:allValuesFrom
# and classify nothing under ELK while still exiting 0.
ex:Measurement a owl:NamedIndividual, sulo:Collection ;
  owl:equivalentClass [ a owl:Restriction ; owl:onProperty sulo:isItemIn ; owl:hasValue ex:Measurement ] .
ex:DrugAdministration a owl:NamedIndividual, sulo:Collection ;
  owl:equivalentClass [ a owl:Restriction ; owl:onProperty sulo:isItemIn ; owl:hasValue ex:DrugAdministration ] .

# What a source row asserts, held apart from whether it is so.
#
# ex:ProcessClaim is an information object: it records that a process of some kind is
# claimed to have occurred, names the roles the claim is about, and carries the recorded
# anchor time. It is not a process and entails none. sulo:hasParticipant is deliberately
# absent, because its domain is sulo:Process and the assertion would come back through it
# whatever the claim is typed as.
ex:ProcessClaim a owl:Class ; rdfs:subClassOf sulo:InformationObject .

# A claim classifies by which reference object it refers to, with no process in the graph.
ex:MeasurementClaim a owl:Class ;
  owl:equivalentClass [ a owl:Class ; owl:intersectionOf
    ( ex:ProcessClaim [ a owl:Restriction ; owl:onProperty sulo:refersTo ; owl:hasValue ex:Measurement ] ) ] .
ex:DrugAdministrationClaim a owl:Class ;
  owl:equivalentClass [ a owl:Class ; owl:intersectionOf
    ( ex:ProcessClaim [ a owl:Restriction ; owl:onProperty sulo:refersTo ; owl:hasValue ex:DrugAdministration ] ) ] .
ex:MeasurementClaim owl:disjointWith ex:DrugAdministrationClaim .
