# DRAFT, not built, not deployed. Option (b) of docs/hosting-plan.md: the mockups served by
# demos/mockups/server.py with the synthetic cohort's execution store, and nothing else.
#
# Build from the repository root (the context), so the root .dockerignore applies:
#   docker build -f deploy/cloudrun/Dockerfile.mockups -t ptm-mockups:draft .
#
# What this image deliberately does NOT contain:
#   - any MIMIC data or MIMIC-derived store (data/local-mimic is in .dockerignore and is never COPYed);
#   - PTM_MIMIC_STORE / PTM_MIMIC_D_ITEMS (never set here, so /api/store/status answers "no store");
#   - the owner secret (it is not used by this image; auth is Cloud Run IAM, see the plan).
# Option (c) would be a different file and a different decision (plan section 2).
ARG PYTHON_IMAGE=python:3.12-slim-bookworm

# Stage 1: regenerate the synthetic cohort from the committed generator (deterministic for its
# seed), as demos/mockups/Dockerfile does. The cohort is never copied in from a working tree.
FROM ${PYTHON_IMAGE} AS cohort
WORKDIR /src
COPY demos/mockups/synthetic/ synthetic/
RUN python synthetic/generate.py --output /src/data/synthetic-paediatric-rare.json

FROM ${PYTHON_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /opt/trajectory

# Base lock plus duckdb==2.0.0 (the store lock). Binary wheels only, as in the root Dockerfile.
COPY patterns/requirements.lock.txt patterns/requirements-store.lock.txt ./patterns/
RUN python -m pip install --no-cache-dir --only-binary=:all: -r patterns/requirements-store.lock.txt \
    && python -c "import duckdb, jsonschema" \
    && groupadd --gid 10001 ptm \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /tmp ptm

# Explicit runtime inputs only. server.py serves its own directory as static files, so copy the
# page directories, not the tests, results or this directory's README beyond what the pages need.
# TO VERIFY on a first build: the exact list of patterns/ resources the store imports (schemas/,
# ontology/ via patterns/_resources.py); the whole of those directories is copied to be safe.
COPY patterns/ ./patterns/
COPY schemas/ ./schemas/
COPY ontology/ ./ontology/
COPY demos/mockups/server.py demos/mockups/store_query.py demos/mockups/store_trajectory.py \
     demos/mockups/store_parity.py demos/mockups/index.html demos/mockups/README.md ./demos/mockups/
COPY demos/mockups/shared/ ./demos/mockups/shared/
COPY demos/mockups/patient-first/ ./demos/mockups/patient-first/
COPY demos/mockups/trajectory/ ./demos/mockups/trajectory/
COPY demos/mockups/store-query/ ./demos/mockups/store-query/
COPY demos/mockups/roadmap/ ./demos/mockups/roadmap/
COPY --from=cohort /src/data/ ./demos/mockups/data/

# The store is built at startup into a temporary directory (about 1.3 s for the page's cohort)
# and removed at exit. /tmp is in-memory on Cloud Run: its size counts against the memory limit.
USER 10001:10001
ENV PORT=8080
EXPOSE 8080
# server.py reads no $PORT itself, so the shell form expands it. exec keeps SIGTERM going to
# Python, which removes the temporary store on SIGTERM.
CMD exec python demos/mockups/server.py --host 0.0.0.0 --port "${PORT}"
