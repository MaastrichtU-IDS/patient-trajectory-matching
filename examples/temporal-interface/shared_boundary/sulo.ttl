    sulo:hasDirectPart bt:Microsecond ;
    sulo:hasValue 4 .

ei:Second a sulo:Unit .

<https://example.org/trajectory/bounded-data/persons/P1> a ex:Person ;
    sulo:hasFeature <https://example.org/trajectory/bounded-data/persons/P1/id> .

<https://example.org/trajectory/bounded-data/variables/As> a bt:TemporalVariable ;
    sulo:hasDirectPart <https://example.org/trajectory/bounded-data/variables/As/clock>,
        <https://example.org/trajectory/bounded-data/variables/As/episode>,
        <https://example.org/trajectory/bounded-data/variables/As/lower>,
        <https://example.org/trajectory/bounded-data/variables/As/patient>,
        <https://example.org/trajectory/bounded-data/variables/As/rdf-identifier>,
        <https://example.org/trajectory/bounded-data/variables/As/source-hash>,
        <https://example.org/trajectory/bounded-data/variables/As/source-key>,
        <https://example.org/trajectory/bounded-data/variables/As/source-location>,
        <https://example.org/trajectory/bounded-data/variables/As/upper> .

<https://example.org/trajectory/bounded-data/variables/Be> a bt:TemporalVariable ;
    sulo:hasDirectPart <https://example.org/trajectory/bounded-data/variables/Be/clock>,
        <https://example.org/trajectory/bounded-data/variables/Be/episode>,
        <https://example.org/trajectory/bounded-data/variables/Be/lower>,
        <https://example.org/trajectory/bounded-data/variables/Be/patient>,
        <https://example.org/trajectory/bounded-data/variables/Be/rdf-identifier>,
        <https://example.org/trajectory/bounded-data/variables/Be/source-hash>,
        <https://example.org/trajectory/bounded-data/variables/Be/source-key>,
        <https://example.org/trajectory/bounded-data/variables/Be/source-location>,
        <https://example.org/trajectory/bounded-data/variables/Be/upper> .

<https://example.org/trajectory/bounded-data/clocks/clock> a ei:TemporalReferenceSystem ;
    sulo:hasDirectPart <https://example.org/trajectory/bounded-data/clocks/clock/clock_id>,
        <https://example.org/trajectory/bounded-data/clocks/clock/origin>,
        <https://example.org/trajectory/bounded-data/clocks/clock/policy>,
        <https://example.org/trajectory/bounded-data/clocks/clock/scope> .

<https://example.org/trajectory/bounded-data/variables/Ae> a bt:TemporalVariable ;
    sulo:hasDirectPart <https://example.org/trajectory/bounded-data/variables/Ae/clock>,
        <https://example.org/trajectory/bounded-data/variables/Ae/episode>,
        <https://example.org/trajectory/bounded-data/variables/Ae/lower>,
        <https://example.org/trajectory/bounded-data/variables/Ae/patient>,
        <https://example.org/trajectory/bounded-data/variables/Ae/rdf-identifier>,
        <https://example.org/trajectory/bounded-data/variables/Ae/source-hash>,
        <https://example.org/trajectory/bounded-data/variables/Ae/source-key>,
        <https://example.org/trajectory/bounded-data/variables/Ae/source-location>,
        <https://example.org/trajectory/bounded-data/variables/Ae/upper> .

bt:Microsecond a sulo:Unit .
