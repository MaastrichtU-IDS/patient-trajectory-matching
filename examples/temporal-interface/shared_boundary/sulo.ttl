@prefix bt: <https://example.org/trajectory/bounded/> .
@prefix data: <https://example.org/trajectory/bounded-data/> .
@prefix ei: <https://example.org/trajectory/interval/> .
@prefix ex: <https://example.org/trajectory/toy/> .
@prefix sulo: <https://w3id.org/sulo/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/trajectory/bounded-data/records/record_A> a ex:SourceRecord ;
    sulo:hasDirectPart <https://example.org/trajectory/bounded-data/records/record_A/episode_id>,
        <https://example.org/trajectory/bounded-data/records/record_A/id>,
        <https://example.org/trajectory/bounded-data/records/record_A/record_id>,
        <https://example.org/trajectory/bounded-data/records/record_A/source-hash>,
        <https://example.org/trajectory/bounded-data/records/record_A/source-key>,
        <https://example.org/trajectory/bounded-data/records/record_A/source-location>,
        <https://example.org/trajectory/bounded-data/records/record_A/status> ;
    sulo:refersTo <https://example.org/trajectory/bounded-data/events/A> .

<https://example.org/trajectory/bounded-data/records/record_B> a ex:SourceRecord ;
    sulo:hasDirectPart <https://example.org/trajectory/bounded-data/records/record_B/episode_id>,
        <https://example.org/trajectory/bounded-data/records/record_B/id>,
        <https://example.org/trajectory/bounded-data/records/record_B/record_id>,
        <https://example.org/trajectory/bounded-data/records/record_B/source-hash>,
        <https://example.org/trajectory/bounded-data/records/record_B/source-key>,
        <https://example.org/trajectory/bounded-data/records/record_B/source-location>,
        <https://example.org/trajectory/bounded-data/records/record_B/status> ;
    sulo:refersTo <https://example.org/trajectory/bounded-data/events/B> .

data:snapshot a bt:Snapshot ;
    sulo:hasDirectPart <https://example.org/trajectory/bounded-data/snapshot/dataset>,
        <https://example.org/trajectory/bounded-data/snapshot/rdf-identifier>,
        <https://example.org/trajectory/bounded-data/snapshot/snapshot>,
        <https://example.org/trajectory/bounded-data/variables/Ae>,
        <https://example.org/trajectory/bounded-data/variables/As>,
        <https://example.org/trajectory/bounded-data/variables/Be> .

<https://example.org/trajectory/bounded-data/clocks/clock/clock_id> a ei:ClockIdentifier ;
    sulo:hasValue "clock"^^xsd:string .

<https://example.org/trajectory/bounded-data/clocks/clock/origin> a ei:ClockOrigin ;
    sulo:hasDirectPart ei:Second ;
    sulo:hasValue "2026-01-01T00:00:00Z"^^xsd:dateTimeStamp .

<https://example.org/trajectory/bounded-data/clocks/clock/policy> a ei:ClockPolicy ;
    sulo:hasValue "offset-datetime-microseconds-v1"^^xsd:string .

<https://example.org/trajectory/bounded-data/clocks/clock/scope> a ei:ClockScope ;
    sulo:hasValue "global"^^xsd:string .

<https://example.org/trajectory/bounded-data/events/A> a bt:Infusion ;
    sulo:atTime <https://example.org/trajectory/bounded-data/events/A/interval> ;
    sulo:hasParticipant <https://example.org/trajectory/bounded-data/events/A/patient-role> .

<https://example.org/trajectory/bounded-data/events/A/end> a bt:EndDescriptor ;
    sulo:refersTo <https://example.org/trajectory/bounded-data/variables/Ae> .

<https://example.org/trajectory/bounded-data/events/A/interval> a bt:OccurrenceInterval ;
    sulo:hasDirectPart <https://example.org/trajectory/bounded-data/events/A/end>,
        <https://example.org/trajectory/bounded-data/events/A/start> .

<https://example.org/trajectory/bounded-data/events/A/patient-role> a ex:PatientRole ;
    sulo:isFeatureOf <https://example.org/trajectory/bounded-data/persons/P1> .

<https://example.org/trajectory/bounded-data/events/A/start> a bt:StartDescriptor ;
    sulo:refersTo <https://example.org/trajectory/bounded-data/variables/As> .

<https://example.org/trajectory/bounded-data/events/B> a bt:SpecimenCollection ;
    sulo:atTime <https://example.org/trajectory/bounded-data/events/B/interval> ;
    sulo:hasParticipant <https://example.org/trajectory/bounded-data/events/B/patient-role> .

<https://example.org/trajectory/bounded-data/events/B/end> a bt:EndDescriptor ;
    sulo:refersTo <https://example.org/trajectory/bounded-data/variables/Be> .

<https://example.org/trajectory/bounded-data/events/B/interval> a bt:OccurrenceInterval ;
    sulo:hasDirectPart <https://example.org/trajectory/bounded-data/events/B/end>,
        <https://example.org/trajectory/bounded-data/events/B/start> .

<https://example.org/trajectory/bounded-data/events/B/patient-role> a ex:PatientRole ;
    sulo:isFeatureOf <https://example.org/trajectory/bounded-data/persons/P1> .

<https://example.org/trajectory/bounded-data/events/B/start> a bt:StartDescriptor ;
    sulo:refersTo <https://example.org/trajectory/bounded-data/variables/Ae> .

<https://example.org/trajectory/bounded-data/persons/P1/id> a ex:PatientIdentifier ;
    sulo:hasValue "P1"^^xsd:string .

<https://example.org/trajectory/bounded-data/records/record_A/episode_id> a ex:EpisodeIdentifier ;
    sulo:hasValue "E1"^^xsd:string .

<https://example.org/trajectory/bounded-data/records/record_A/id> a ex:EventIdentifier ;
    sulo:hasValue "A"^^xsd:string .

<https://example.org/trajectory/bounded-data/records/record_A/record_id> a ex:RecordIdentifier ;
    sulo:hasValue "record_A"^^xsd:string .

<https://example.org/trajectory/bounded-data/records/record_A/source-hash> a ex:SourceHash ;
    sulo:hasValue "8f84b764e9188e87a34fc7ec3f59cf067608585280bf511c5e73cafe6b2aa9e0"^^xsd:string .

<https://example.org/trajectory/bounded-data/records/record_A/source-key> a ex:SourceKey ;
    sulo:hasValue "fixture_A"^^xsd:string .

<https://example.org/trajectory/bounded-data/records/record_A/source-location> a ex:SourceLocation ;
    sulo:hasValue "constructed://bounded-interval/source.json"^^xsd:string .

<https://example.org/trajectory/bounded-data/records/record_A/status> a ex:RecordStatus ;
    sulo:hasValue "performed"^^xsd:string .

<https://example.org/trajectory/bounded-data/records/record_B/episode_id> a ex:EpisodeIdentifier ;
    sulo:hasValue "E1"^^xsd:string .

<https://example.org/trajectory/bounded-data/records/record_B/id> a ex:EventIdentifier ;
    sulo:hasValue "B"^^xsd:string .

<https://example.org/trajectory/bounded-data/records/record_B/record_id> a ex:RecordIdentifier ;
    sulo:hasValue "record_B"^^xsd:string .

<https://example.org/trajectory/bounded-data/records/record_B/source-hash> a ex:SourceHash ;
    sulo:hasValue "a7205a278041ba6b20ff409e06a75acb853180c3a98b0849ed83d6b4a8a5557e"^^xsd:string .

<https://example.org/trajectory/bounded-data/records/record_B/source-key> a ex:SourceKey ;
    sulo:hasValue "fixture_B"^^xsd:string .

<https://example.org/trajectory/bounded-data/records/record_B/source-location> a ex:SourceLocation ;
    sulo:hasValue "constructed://bounded-interval/source.json"^^xsd:string .

<https://example.org/trajectory/bounded-data/records/record_B/status> a ex:RecordStatus ;
    sulo:hasValue "performed"^^xsd:string .

<https://example.org/trajectory/bounded-data/snapshot/dataset> a bt:DatasetIdentifier ;
    sulo:hasValue "mapping_examples"^^xsd:string .

<https://example.org/trajectory/bounded-data/snapshot/rdf-identifier> a <https://example.org/trajectory/bounded-rdf/ProfileIdentifier> ;
    sulo:hasValue "bounded-rdf-1.0"^^xsd:string .

<https://example.org/trajectory/bounded-data/snapshot/snapshot> a bt:SnapshotIdentifier ;
    sulo:hasValue "shared_boundary"^^xsd:string .

<https://example.org/trajectory/bounded-data/variables/Ae/clock> a ei:ClockBinding ;
    sulo:refersTo <https://example.org/trajectory/bounded-data/clocks/clock> .

<https://example.org/trajectory/bounded-data/variables/Ae/episode> a ex:EpisodeIdentifier ;
    sulo:hasValue "E1"^^xsd:string .

<https://example.org/trajectory/bounded-data/variables/Ae/lower> a bt:LowerBound ;
    sulo:hasDirectPart bt:Microsecond ;
    sulo:hasValue 2 .

<https://example.org/trajectory/bounded-data/variables/Ae/patient> a ex:PatientIdentifier ;
    sulo:hasValue "P1"^^xsd:string .

<https://example.org/trajectory/bounded-data/variables/Ae/rdf-identifier> a <https://example.org/trajectory/bounded-rdf/VariableIdentifier> ;
    sulo:hasValue "Ae"^^xsd:string .

<https://example.org/trajectory/bounded-data/variables/Ae/source-hash> a ex:SourceHash ;
    sulo:hasValue "cb4516cef1842b70ff256f9297c8f08666c829e92bccd036c6dcb785ef6f5f8d"^^xsd:string .

<https://example.org/trajectory/bounded-data/variables/Ae/source-key> a ex:SourceKey ;
    sulo:hasValue "fixture_Ae"^^xsd:string .

<https://example.org/trajectory/bounded-data/variables/Ae/source-location> a ex:SourceLocation ;
    sulo:hasValue "constructed://bounded-interval/source.json"^^xsd:string .

<https://example.org/trajectory/bounded-data/variables/Ae/upper> a bt:UpperBound ;
    sulo:hasDirectPart bt:Microsecond ;
    sulo:hasValue 2 .

<https://example.org/trajectory/bounded-data/variables/As/clock> a ei:ClockBinding ;
    sulo:refersTo <https://example.org/trajectory/bounded-data/clocks/clock> .

<https://example.org/trajectory/bounded-data/variables/As/episode> a ex:EpisodeIdentifier ;
    sulo:hasValue "E1"^^xsd:string .

<https://example.org/trajectory/bounded-data/variables/As/lower> a bt:LowerBound ;
    sulo:hasDirectPart bt:Microsecond ;
    sulo:hasValue 0 .

<https://example.org/trajectory/bounded-data/variables/As/patient> a ex:PatientIdentifier ;
    sulo:hasValue "P1"^^xsd:string .

<https://example.org/trajectory/bounded-data/variables/As/rdf-identifier> a <https://example.org/trajectory/bounded-rdf/VariableIdentifier> ;
    sulo:hasValue "As"^^xsd:string .

