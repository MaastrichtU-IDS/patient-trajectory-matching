    sulo:hasValue "48b0980f09b9ef2e64f32cde569c6c172062f934f033fdcbf0095b721d0175ba"^^xsd:string .

<https://example.org/trajectory/bounded-data/variables/As/source-key> a ex:SourceKey ;
    sulo:hasValue "fixture_As"^^xsd:string .

<https://example.org/trajectory/bounded-data/variables/As/source-location> a ex:SourceLocation ;
    sulo:hasValue "constructed://bounded-interval/source.json"^^xsd:string .

<https://example.org/trajectory/bounded-data/variables/As/upper> a bt:UpperBound ;
    sulo:hasDirectPart bt:Microsecond ;
    sulo:hasValue 0 .

<https://example.org/trajectory/bounded-data/variables/Be/clock> a ei:ClockBinding ;
    sulo:refersTo <https://example.org/trajectory/bounded-data/clocks/clock> .

<https://example.org/trajectory/bounded-data/variables/Be/episode> a ex:EpisodeIdentifier ;
    sulo:hasValue "E1"^^xsd:string .

<https://example.org/trajectory/bounded-data/variables/Be/lower> a bt:LowerBound ;
    sulo:hasDirectPart bt:Microsecond ;
    sulo:hasValue 4 .

<https://example.org/trajectory/bounded-data/variables/Be/patient> a ex:PatientIdentifier ;
    sulo:hasValue "P1"^^xsd:string .

<https://example.org/trajectory/bounded-data/variables/Be/rdf-identifier> a <https://example.org/trajectory/bounded-rdf/VariableIdentifier> ;
    sulo:hasValue "Be"^^xsd:string .

<https://example.org/trajectory/bounded-data/variables/Be/source-hash> a ex:SourceHash ;
    sulo:hasValue "7707fffc209c8e875a3cf0f694f9468d223be24303090252fedf8f4ee7d7e7aa"^^xsd:string .

<https://example.org/trajectory/bounded-data/variables/Be/source-key> a ex:SourceKey ;
