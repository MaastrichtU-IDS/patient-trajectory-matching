PREFIX ex: <https://example.org/trajectory/toy/>
PREFIX sulo: <https://w3id.org/sulo/>

# Measurement claims, not measurements. ?claim is an ex:ProcessClaim that refers to the
# ex:Measurement reference object; nothing here asserts that a measurement occurred.
SELECT ?claim ?person ?patientRole ?result ?quality ?value ?unit ?timestamp
WHERE {
  ?claim a ex:ProcessClaim ;
    sulo:refersTo ex:Measurement, ?patientRole, ?resultRole ;
    sulo:hasPart ?time .
  ?patientRole a ex:PatientRole ; sulo:isFeatureOf ?person .
  ?resultRole a ex:MeasurementResultRole ; sulo:isFeatureOf ?result .
  ?result a ex:CreatinineResult ;
    sulo:hasValue ?value ; sulo:hasPart ?unit ; sulo:refersTo ?quality .
  ?quality a ex:CreatinineConcentration ; sulo:isFeatureOf ?person .
  ?time sulo:hasValue ?timestamp .
}
ORDER BY ?claim
