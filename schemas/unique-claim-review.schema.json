{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "package_context_id",
    "reviewer",
    "claims",
    "calendars"
  ],
  "properties": {
    "profile": {
      "const": "unique-claim-review-1.0"
    },
    "package_context_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        {
          "type": "null"
        }
      ]
    },
    "claims": {
      "type": "array",
      "maxItems": 69632,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "claim_sha256",
          "decisions"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 128
          },
          "claim_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "decisions": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "action",
                "supersedes",
                "reason"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+$",
                  "maxLength": 128
                },
                "action": {
                  "enum": [
                    "accept",
                    "reject",
                    "withdraw"
                  ]
                },
                "supersedes": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$",
                      "maxLength": 128
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              }
            }
          }
        }
      }
    },
    "calendars": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "patient_id",
          "decision",
          "reason"
        ],
        "properties": {
          "patient_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "decision": {
            "enum": [
              "pending",
              "same_patient_calendar",
              "not_aligned"
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
