{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "queries"],
  "properties": {
    "profile": {"const": "configured-pressure-workload-1.0"},
    "queries": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["threshold", "baseline_minutes", "followup_minutes"],
        "properties": {
          "threshold": {"type": "string", "minLength": 1, "maxLength": 12},
          "baseline_minutes": {"type": "integer", "minimum": 1, "maximum": 30},
          "followup_minutes": {"type": "integer", "minimum": 0, "maximum": 120}
        }
      }
    }
  }
}
