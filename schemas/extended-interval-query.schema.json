{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "profile": {
      "const": "extended-interval-query-1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "class_iri": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "class_iri"
        ]
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "operator": {
                "enum": [
                  "before",
                  "meets",
                  "overlaps",
                  "starts",
                  "during",
                  "finishes",
                  "equals",
                  "after",
                  "met_by",
                  "overlapped_by",
                  "started_by",
                  "contains",
                  "finished_by"
                ]
              },
              "left": {
                "type": "string",
                "minLength": 1
              },
              "right": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "operator",
              "left",
              "right"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "operator": {
                "const": "gap"
              },
              "left": {
                "type": "string",
                "minLength": 1
              },
              "right": {
                "type": "string",
                "minLength": 1
              },
              "min_gap_us": {
                "type": "integer",
                "minimum": -9223372036854775808,
                "maximum": 9223372036854775807
              },
              "max_gap_us": {
                "type": "integer",
                "minimum": -9223372036854775808,
                "maximum": 9223372036854775807
              }
            },
            "required": [
              "id",
              "operator",
              "left",
              "right",
              "min_gap_us",
              "max_gap_us"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "operator": {
                "const": "minimum_overlap"
              },
              "left": {
                "type": "string",
                "minLength": 1
              },
              "right": {
                "type": "string",
                "minLength": 1
              },
              "minimum_us": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              }
            },
            "required": [
              "id",
              "operator",
              "left",
              "right",
              "minimum_us"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "operator": {
                "const": "duration"
              },
              "slot": {
                "type": "string",
                "minLength": 1
              },
              "minimum_us": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "maximum_us": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              }
            },
            "required": [
              "id",
              "operator",
              "slot",
              "minimum_us",
              "maximum_us"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "profile",
    "id",
    "slots",
    "constraints"
  ]
}
