{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "dataset_id",
    "release",
    "itemids",
    "source_sha256"
  ],
  "properties": {
    "profile": {
      "const": "measurement-source-catalogue-1.0"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "release": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "itemids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,15}$"
      }
    },
    "source_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chartevents",
        "icustays",
        "d_items"
      ],
      "properties": {
        "chartevents": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "icustays": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "d_items": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
