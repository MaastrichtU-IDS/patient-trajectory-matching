{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "dataset_id",
    "snapshot_id",
    "clocks",
    "variables",
    "events",
    "constraints"
  ],
  "properties": {
    "profile": {
      "const": "patient-local-record-interval-1.0"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "clocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clock_id",
          "origin",
          "scope",
          "policy",
          "origin_source_key"
        ],
        "properties": {
          "clock_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "pattern": "^patient:[A-Za-z0-9_-]+$"
          },
          "policy": {
            "const": "patient-local-calendar-microseconds-v1"
          },
          "origin_source_key": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "patient_id",
          "episode_id",
          "clock_id",
          "source_key",
          "local_lower",
          "local_upper"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "patient_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "episode_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "clock_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "source_key": {
            "type": "string",
            "minLength": 1
          },
          "local_lower": {
            "type": "string",
            "minLength": 1
          },
          "local_upper": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "record_id",
          "patient_id",
          "episode_id",
          "event_kind",
          "status",
          "start_var",
          "end_var",
          "source_key"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "record_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "patient_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "episode_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "event_kind": {
            "const": "recorded_input_segment"
          },
          "status": {
            "const": "recorded"
          },
          "start_var": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "end_var": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "source_key": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "left_var",
          "right_var",
          "upper_us",
          "source_key"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "left_var": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "right_var": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "upper_us": {
            "type": "integer",
            "minimum": -9223372036854775808,
            "maximum": 9223372036854775807
          },
          "source_key": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Patient-local recorded interval source 1.0",
  "$defs": {
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "id",
        "slots",
        "constraints"
      ],
      "properties": {
        "profile": {
          "const": "patient-local-record-query-1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "class_iri"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "class_iri": {
                "enum": [
                  "https://example.org/trajectory/bounded/Infusion",
                  "https://example.org/trajectory/bounded/SpecimenCollection",
                  "https://example.org/trajectory/bounded/IntervalProcess",
                  "https://w3id.org/sulo/Process",
                  "https://example.org/trajectory/bounded/RecordedInputSegment"
                ]
              }
            }
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "left",
              "right",
              "operator"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "left": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "right": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "operator": {
                "enum": [
                  "before",
                  "meets",
                  "overlaps",
                  "gap"
                ]
              },
              "min_gap_us": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "max_gap_us": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "operator": {
                      "const": "gap"
                    }
                  }
                },
                "then": {
                  "required": [
                    "min_gap_us",
                    "max_gap_us"
                  ]
                },
                "else": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "min_gap_us"
                        ]
                      },
                      {
                        "required": [
                          "max_gap_us"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "title": "Bounded interval query 1.0"
    }
  }
}
