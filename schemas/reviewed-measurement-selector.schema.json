{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "mapping_context_id",
    "class_iri",
    "source_item_ids",
    "unit_lexical"
  ],
  "properties": {
    "profile": {
      "const": "reviewed-measurement-selector-1.0"
    },
    "mapping_context_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "class_iri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "source_item_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      }
    },
    "unit_lexical": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^\\S(?:.*\\S)?$"
    }
  }
}
