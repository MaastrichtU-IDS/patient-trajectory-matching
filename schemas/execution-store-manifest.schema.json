{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Execution store snapshot manifest",
  "description": "One immutable execution-store snapshot: its identity, inputs, builder and tables. The snapshot_id is the sha256 of the canonical JSON of profile, input_digest, closure_version, builder.artifacts and each table's rows and content_digest (docs/execution-store.md).",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "snapshot_id", "dataset_id", "input_digest", "closure_version", "time", "buckets",
               "canonical_form", "selection", "builder", "tables"],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "type": {"enum": ["INTEGER", "BIGINT", "VARCHAR", "BOOLEAN"]}
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "content_digest", "columns", "path", "partitioned_by"],
      "properties": {
        "rows": {"type": "integer", "minimum": 0},
        "content_digest": {"$ref": "#/$defs/sha256"},
        "columns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/column"}},
        "path": {"type": "string", "pattern": "^[a-z_]+(\\.parquet)?$"},
        "partitioned_by": {"enum": ["bucket", null]}
      }
    }
  },
  "properties": {
    "profile": {"const": "execution-store-1.0"},
    "snapshot_id": {"$ref": "#/$defs/sha256"},
    "dataset_id": {"type": "string", "minLength": 1},
    "input_digest": {"$ref": "#/$defs/sha256"},
    "closure_version": {"type": "string", "minLength": 1},
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "origin", "calendar"],
      "properties": {
        "unit": {"const": "microsecond"},
        "origin": {"const": "0001-01-01T00:00:00"},
        "calendar": {"const": "patient_local"}
      }
    },
    "buckets": {"type": "integer", "minimum": 1},
    "canonical_form": {"type": "string", "minLength": 1},
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts", "engine", "engine_version"],
      "properties": {
        "artifacts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[A-Za-z0-9_./-]+$"},
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "engine": {"const": "duckdb"},
        "engine_version": {"type": "string", "minLength": 1}
      }
    },
    "tables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patients", "events", "event_concepts", "concept_closure", "concept_postings", "coverage",
                   "source_concepts"],
      "properties": {
        "patients": {"$ref": "#/$defs/table"},
        "events": {"$ref": "#/$defs/table"},
        "event_concepts": {"$ref": "#/$defs/table"},
        "concept_closure": {"$ref": "#/$defs/table"},
        "concept_postings": {"$ref": "#/$defs/table"},
        "coverage": {"$ref": "#/$defs/table"},
        "source_concepts": {"$ref": "#/$defs/table"}
      }
    },
    "selection": {
      "description": "How the ingest selected records (copied from its provenance.selection), or null if it did not say.",
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["mode", "version", "available_at"],
          "properties": {
            "mode": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "available_at": {"type": "string", "minLength": 1},
            "records_available_after_occurrence": {"type": "integer", "minimum": 0}
          }
        }
      ]
    }
  }
}
