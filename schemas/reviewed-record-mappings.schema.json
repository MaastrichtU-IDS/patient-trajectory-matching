{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/trajectory/schemas/reviewed-record-mappings",
  "oneOf": [
    {
      "$ref": "#/$defs/catalogue"
    },
    {
      "$ref": "#/$defs/terminology"
    },
    {
      "$ref": "#/$defs/mappings"
    },
    {
      "$ref": "#/$defs/review"
    }
  ],
  "$defs": {
    "catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "dataset_id",
        "release",
        "source_kind",
        "entries"
      ],
      "properties": {
        "profile": {
          "const": "mapping-source-catalogue-1.0"
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        "release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        "source_kind": {
          "enum": [
            "authored_fixture",
            "supplied_catalogue"
          ]
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "label",
              "source_class_iri"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "\\S"
              },
              "source_class_iri": {
                "type": "string",
                "pattern": "^https?://[^\\s<>]+$",
                "maxLength": 512
              }
            }
          }
        }
      }
    },
    "terminology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "system",
        "version",
        "record_class_namespace",
        "terms"
      ],
      "properties": {
        "profile": {
          "const": "record-query-terminology-1.0"
        },
        "system": {
          "type": "string",
          "pattern": "^https?://[^\\s<>]+$",
          "maxLength": 512
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        "record_class_namespace": {
          "type": "string",
          "pattern": "^https?://[^\\s<>]+$",
          "maxLength": 512
        },
        "terms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "label",
              "concept_iri",
              "record_class_iri"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "\\S"
              },
              "concept_iri": {
                "type": "string",
                "pattern": "^https?://[^\\s<>]+$",
                "maxLength": 512
              },
              "record_class_iri": {
                "type": "string",
                "pattern": "^https?://[^\\s<>]+$",
                "maxLength": 512
              }
            }
          }
        }
      }
    },
    "mappings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "id",
        "catalogue_sha256",
        "terminology_sha256",
        "entries"
      ],
      "properties": {
        "profile": {
          "const": "record-mapping-proposals-1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "catalogue_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "terminology_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source_code",
              "target_code",
              "relation",
              "rationale"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "source_code": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "target_code": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "relation": {
                "const": "source_record_subclass_of_target_record"
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "mappings_sha256",
        "decisions"
      ],
      "properties": {
        "profile": {
          "const": "record-mapping-review-1.0"
        },
        "mappings_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decisions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "mapping_id",
              "mapping_sha256",
              "action",
              "supersedes",
              "reviewer",
              "reason"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "mapping_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "mapping_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "action": {
                "enum": [
                  "accept",
                  "withdraw"
                ]
              },
              "supersedes": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reviewer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "\\S"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    }
  }
}
