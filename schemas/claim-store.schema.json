{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "dataset_id",
    "snapshot_id",
    "clocks",
    "claims"
  ],
  "properties": {
    "profile": {
      "const": "claim-store-1.0"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "maxLength": 128
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "maxLength": 128
    },
    "clocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clock_id",
          "origin",
          "scope",
          "policy"
        ],
        "properties": {
          "clock_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "policy": {
            "const": "offset-datetime-microseconds-v1"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "patient_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "episode_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "bundle": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "variables": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "patient_id",
                    "episode_id",
                    "clock_id",
                    "lower_us",
                    "upper_us",
                    "source_key"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "patient_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "episode_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "clock_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "lower_us": {
                      "type": "integer",
                      "minimum": -9223372036854775808,
                      "maximum": 9223372036854775807
                    },
                    "upper_us": {
                      "type": "integer",
                      "minimum": -9223372036854775808,
                      "maximum": 9223372036854775807
                    },
                    "source_key": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "events": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "record_id",
                    "patient_id",
                    "episode_id",
                    "event_kind",
                    "status",
                    "start_var",
                    "end_var",
                    "source_key"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "record_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "patient_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "episode_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "event_kind": {
                      "enum": [
                        "infusion",
                        "specimen_collection"
                      ]
                    },
                    "status": {
                      "const": "performed"
                    },
                    "start_var": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "end_var": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "source_key": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "constraints": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "left_var",
                    "right_var",
                    "upper_us",
                    "source_key"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "left_var": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "right_var": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "upper_us": {
                      "type": "integer",
                      "minimum": -9223372036854775808,
                      "maximum": 9223372036854775807
                    },
                    "source_key": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "semantic_facts": {
                "type": "array",
                "maxItems": 256,
                "items": {
                  "$ref": "#/$defs/semantic_fact"
                }
              }
            },
            "required": [
              "variables",
              "events",
              "constraints",
              "semantic_facts"
            ]
          },
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 128
          },
          "source_record_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 128
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "patient_id",
          "episode_id",
          "bundle",
          "source_id",
          "source_record_id",
          "source_sha256"
        ]
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "semantic_fact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "patient_id",
            "episode_id",
            "kind",
            "local_id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "patient_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "episode_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "kind": {
              "const": "individual"
            },
            "local_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "patient_id",
            "episode_id",
            "kind",
            "subject",
            "class_iri"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "patient_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "episode_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "kind": {
              "const": "class"
            },
            "subject": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "event_id"
                  ],
                  "properties": {
                    "event_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "local_id"
                  ],
                  "properties": {
                    "local_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    }
                  }
                }
              ]
            },
            "class_iri": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "patient_id",
            "episode_id",
            "kind",
            "subject",
            "property_iri",
            "object"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "patient_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "episode_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "kind": {
              "const": "property"
            },
            "subject": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "event_id"
                  ],
                  "properties": {
                    "event_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "local_id"
                  ],
                  "properties": {
                    "local_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    }
                  }
                }
              ]
            },
            "property_iri": {
              "enum": [
                "https://w3id.org/sulo/hasParticipant",
                "https://w3id.org/sulo/isFeatureOf"
              ]
            },
            "object": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "event_id"
                  ],
                  "properties": {
                    "event_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "local_id"
                  ],
                  "properties": {
                    "local_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "id",
        "store_sha256",
        "semantic_policy_sha256",
        "decisions"
      ],
      "properties": {
        "profile": {
          "const": "claim-acceptance-policy-1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 128
        },
        "store_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "semantic_policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "decisions": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "claim_id",
              "claim_sha256",
              "action",
              "supersedes",
              "reason"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$",
                "maxLength": 128
              },
              "claim_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$",
                "maxLength": 128
              },
              "claim_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "action": {
                "enum": [
                  "accept",
                  "reject",
                  "withdraw"
                ]
              },
              "supersedes": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]+$",
                    "maxLength": 128
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          }
        }
      }
    }
  }
}
