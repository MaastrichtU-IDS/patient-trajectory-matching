{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "profile": {
      "const": "joint-evidence-archive-1.0"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "archive_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "published_at": {
      "type": "string",
      "minLength": 1
    },
    "history_coverage": {
      "enum": [
        "complete",
        "partial",
        "unavailable"
      ]
    },
    "availability_axis": {
      "const": "absolute-offset-datetime"
    },
    "mapping_policy_id": {
      "type": "string",
      "minLength": 1
    },
    "clocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clock_id",
          "origin",
          "scope",
          "policy"
        ],
        "properties": {
          "clock_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "policy": {
            "const": "offset-datetime-microseconds-v1"
          }
        }
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "patient_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "episode_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "bundle": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "variables": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "patient_id",
                    "episode_id",
                    "clock_id",
                    "lower_us",
                    "upper_us",
                    "source_key"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "patient_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "episode_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "clock_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "lower_us": {
                      "type": "integer",
                      "minimum": -9223372036854775808,
                      "maximum": 9223372036854775807
                    },
                    "upper_us": {
                      "type": "integer",
                      "minimum": -9223372036854775808,
                      "maximum": 9223372036854775807
                    },
                    "source_key": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "events": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "record_id",
                    "patient_id",
                    "episode_id",
                    "event_kind",
                    "status",
                    "start_var",
                    "end_var",
                    "source_key"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "record_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "patient_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "episode_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "event_kind": {
                      "enum": [
                        "infusion",
                        "specimen_collection"
                      ]
                    },
                    "status": {
                      "const": "performed"
                    },
                    "start_var": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "end_var": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "source_key": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "constraints": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "left_var",
                    "right_var",
                    "upper_us",
                    "source_key"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "left_var": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "right_var": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "upper_us": {
                      "type": "integer",
                      "minimum": -9223372036854775808,
                      "maximum": 9223372036854775807
                    },
                    "source_key": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "semantic_facts": {
                "type": "array",
                "maxItems": 256,
                "items": {
                  "$ref": "#/$defs/semantic_fact"
                }
              }
            },
            "required": [
              "variables",
              "events",
              "constraints",
              "semantic_facts"
            ]
          }
        },
        "required": [
          "id",
          "patient_id",
          "episode_id",
          "bundle"
        ]
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "patient_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "episode_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "operation": {
            "enum": [
              "assert",
              "withdraw"
            ]
          },
          "assertion_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "supersedes": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_available_at": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "source_recorded_at": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "archived_at": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "source_id",
          "patient_id",
          "episode_id",
          "operation",
          "assertion_id",
          "supersedes",
          "source_available_at",
          "source_recorded_at",
          "archived_at"
        ]
      }
    }
  },
  "required": [
    "profile",
    "dataset_id",
    "archive_id",
    "published_at",
    "history_coverage",
    "availability_axis",
    "mapping_policy_id",
    "clocks",
    "assertions",
    "entries"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Joint temporal and semantic evidence archive 1.0",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "evidence-selection-request-1.0"
        },
        "mode": {
          "enum": [
            "source_as_known",
            "retrospective"
          ]
        },
        "patient_cutoffs": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "admissible_source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "revision_policy": {
          "const": "explicit-source-chain-1.0"
        },
        "missing_availability_policy": {
          "const": "block"
        },
        "semantic_policy": {
          "const": "current-pinned-retrospective"
        }
      },
      "required": [
        "profile",
        "mode",
        "patient_cutoffs",
        "admissible_source_ids",
        "revision_policy",
        "missing_availability_policy",
        "semantic_policy"
      ]
    },
    "semantic_fact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "patient_id",
            "episode_id",
            "kind",
            "local_id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "patient_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "episode_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "kind": {
              "const": "individual"
            },
            "local_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "patient_id",
            "episode_id",
            "kind",
            "subject",
            "class_iri"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "patient_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "episode_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "kind": {
              "const": "class"
            },
            "subject": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "event_id"
                  ],
                  "properties": {
                    "event_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "local_id"
                  ],
                  "properties": {
                    "local_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    }
                  }
                }
              ]
            },
            "class_iri": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "patient_id",
            "episode_id",
            "kind",
            "subject",
            "property_iri",
            "object"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "patient_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "episode_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "kind": {
              "const": "property"
            },
            "subject": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "event_id"
                  ],
                  "properties": {
                    "event_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "local_id"
                  ],
                  "properties": {
                    "local_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    }
                  }
                }
              ]
            },
            "property_iri": {
              "enum": [
                "https://w3id.org/sulo/hasParticipant",
                "https://w3id.org/sulo/isFeatureOf"
              ]
            },
            "object": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "event_id"
                  ],
                  "properties": {
                    "event_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "local_id"
                  ],
                  "properties": {
                    "local_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+$"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  }
}
