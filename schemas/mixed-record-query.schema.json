{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "id",
    "treatment_class_iri",
    "baseline",
    "followup"
  ],
  "properties": {
    "profile": {
      "const": "mixed-record-trajectory-1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "maxLength": 128
    },
    "treatment_class_iri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_ids",
        "unit_lexical",
        "operator",
        "value_lexical",
        "min_before_start_us",
        "max_before_start_us"
      ],
      "properties": {
        "item_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "unit_lexical": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "operator": {
          "enum": [
            "lt",
            "le",
            "eq",
            "ge",
            "gt"
          ]
        },
        "value_lexical": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "min_before_start_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "max_before_start_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    },
    "followup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_ids",
        "unit_lexical",
        "anchor",
        "min_after_anchor_us",
        "max_after_anchor_us",
        "within_interval"
      ],
      "properties": {
        "item_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "unit_lexical": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "anchor": {
          "enum": [
            "start",
            "end"
          ]
        },
        "min_after_anchor_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "max_after_anchor_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "within_interval": {
          "type": "boolean"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "id",
        "interval_store_sha256",
        "measurement_store_sha256",
        "bindings"
      ],
      "properties": {
        "profile": {
          "const": "patient-local-clock-alignment-1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 128
        },
        "interval_store_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "measurement_store_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bindings": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "patient_id",
              "interval_clock_id",
              "measurement_clock_id",
              "basis",
              "reason"
            ],
            "properties": {
              "patient_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$",
                "maxLength": 128
              },
              "interval_clock_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$",
                "maxLength": 128
              },
              "measurement_clock_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$",
                "maxLength": 128
              },
              "basis": {
                "const": "same_dataset_patient_calendar"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          }
        }
      }
    }
  }
}
